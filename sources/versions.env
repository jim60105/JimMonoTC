# Pinned upstream inputs. Change a version here AND update checksums.sha256.

# Cascadia Code (Microsoft): Latin, ligatures, Powerline and Nerd Font symbols ("NF" build).
CASCADIA_VERSION=2407.24
CASCADIA_URL=https://github.com/microsoft/cascadia-code/releases/download/v${CASCADIA_VERSION}/CascadiaCode-${CASCADIA_VERSION}.zip
CASCADIA_ARCHIVE=CascadiaCode-${CASCADIA_VERSION}.zip
# Members extracted from the archive: ttf/static/CascadiaCodeNF-<Style>.ttf
CASCADIA_STYLES="Regular Bold Italic BoldItalic"

# Nerd Fonts glyph sources (FontPatcher archive): fills the icons Cascadia Code NF lacks, and
# provides the glyph-set table and licence files.  font-patcher itself is not run.
NERD_FONTS_VERSION=3.4.0
NERD_FONTS_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v${NERD_FONTS_VERSION}/FontPatcher.zip
NERD_FONTS_ARCHIVE=nerd-fonts-v${NERD_FONTS_VERSION}-FontPatcher.zip

# Noto Sans CJK 2.004 (name table: "Version 2.004"), pinned by git commit.
NOTO_CJK_REPO=https://github.com/notofonts/noto-cjk
NOTO_CJK_COMMIT=f8d157532fbfaeda587e826d4cd5b21a49186f7c
NOTO_CJK_DIR=Sans/OTF/TraditionalChinese
# Regular / Bold: the CJK of the matching styles (Noto has no italic: Italic / BoldItalic use
# the upright weight, slanted by build.sh).  Black: the arrows Cascadia lacks (add-arrows.py).
NOTO_CJK_WEIGHTS="Regular Bold Black"
# Path in the repository / file name in .cache/downloads for a weight:
#   ${NOTO_CJK_DIR}/NotoSansCJKtc-<Weight>.otf  /  NotoSansCJKtc-<Weight>-2.004.otf
